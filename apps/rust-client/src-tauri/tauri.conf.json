{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Switch",
  "version": "0.1.0",
  "identifier": "com.kekexiaoai.codex-switch",
  "build": {
    "beforeDevCommand": "cd ../ui && npm run dev",
    "beforeBuildCommand": "cd ../ui && npm run build",
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Switch",
        "width": 1240,
        "height": 840,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "visible": false,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../../packaging/icons/AppIcon.icns",
      "../../../packaging/icons/icon.ico",
      "../../../packaging/icons/icon.png"
    ]
  }
}
